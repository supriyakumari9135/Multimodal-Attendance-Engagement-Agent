# Multimodal Attendance & Engagement Agent Configuration
PROJECT_NAME="Multimodal Attendance & Engagement Agent"
VERSION="1.0.0"
API_V1_PREFIX="/api"

# Local SQLite Database URL
DATABASE_URL="sqlite:///./data/attendance.db"

# Privacy & Media Retention
MEDIA_RETENTION_HOURS=24
ENABLE_ANONYMOUS_DEFAULT=true
ALLOW_IDENTITY_MATCHING=true

# Vision Processing Configuration
DEFAULT_SAMPLE_RATE_FPS=1.0
MIN_OBSERVATION_SECONDS_PRESENT=30.0

# Frontend URL
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

